# EditorConfig helps maintain consistent coding styles across editors and IDEs
# https://editorconfig.org

root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown files: preserve trailing spaces (used for line breaks)
[*.md]
trim_trailing_whitespace = false

# Makefile: use tabs
[Makefile]
indent_style = tab

# Package.json and lockfiles: 2 spaces
[{package.json,package-lock.json,*.lock}]
indent_size = 2

# Shell scripts
[*.sh]
end_of_line = lf

# Batch files (Windows)
[*.{bat,cmd}]
end_of_line = crlf
