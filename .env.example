# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/stokflow_dev?schema=public"

# Server Configuration
NODE_ENV="development"
PORT=3000
API_BASE_URL="http://localhost:3000"

# Frontend Configuration
VITE_API_BASE_URL="http://localhost:3000/api/v1"

# Session/Authentication Configuration
SESSION_SECRET="CHANGE_THIS_TO_A_RANDOM_STRING_AT_LEAST_32_CHARACTERS_LONG"
SESSION_MAX_AGE_MS=86400000

# Security Configuration
CORS_ORIGIN="http://localhost:5173"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL="info"

# Note: Never commit actual credentials to version control.
# Copy this file to .env and fill in real values for local development.
# Use secure secret management for production deployment.
