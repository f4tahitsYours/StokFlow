    "react-router-dom": "7.1.1"
  },
  "devDependencies": {
    "@eslint/js": "9.18.0",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.18.0",
    "jsdom": "30.1.3",
    "typescript": "5.7.3",
    "typescript-eslint": "8.20.0",
    "vite": "6.0.7",
    "vitest": "2.1.8"
  }
